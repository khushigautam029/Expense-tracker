{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",

    "migrate": "sequelize-cli db:migrate --config config/config.cjs",
    "migrate:undo": "sequelize-cli db:migrate:undo --config config/config.cjs",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all --config config/config.cjs",
    "migrate:status": "sequelize-cli db:migrate:status --config config/config.cjs",
    "migration:create": "sequelize-cli migration:generate --config config/config.cjs --name",

    "seed": "sequelize-cli db:seed:all --config config/config.cjs",
    "seed:undo": "sequelize-cli db:seed:undo --config config/config.cjs",
    "seed:undo:all": "sequelize-cli db:seed:undo:all --config config/config.cjs",
    "seed:create": "sequelize-cli seed:generate --config config/config.cjs --name",
    
    "migrate:test": "sequelize-cli db:migrate --env test --config config/config.cjs",
    "migrate:test:undo": "sequelize-cli db:migrate:undo --env test --config config/config.cjs",
    "migrate:test:undo:all": "sequelize-cli db:migrate:undo:all --env test --config config/config.cjs",
    "migrate:test:status": "sequelize-cli db:migrate:status --env test --config config/config.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.2",
    "pdfkit": "^0.19.1",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}